# Postgres connection string. Leave unset to use an embedded PGlite database in ./.pglite
# DATABASE_URL=postgres://reelmath:reelmath@localhost:5432/reelmath

# Enables AI-written fishing word problems. Without it, built-in templates are used.
# ANTHROPIC_API_KEY=

# Max AI word-problem generations per parent account per day (default 30)
# AI_DAILY_LIMIT=30
